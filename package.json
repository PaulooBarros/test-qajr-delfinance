{
  "name": "delfinance-e2e",
  "version": "1.0.0",
  "description": "Testes automatizados E2E do DelFinance com Cypress + TypeScript",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "test:login": "cypress run --spec \"cypress/e2e/login/**/*.cy.ts\"",
    "test:home": "cypress run --spec \"cypress/e2e/home/**/*.cy.ts\"",
    "test:pix": "cypress run --spec \"cypress/e2e/pix/**/*.cy.ts\"",
    "typecheck": "tsc --noEmit",
    "test:ci": "cypress run --spec \"cypress/e2e/login/**/*.cy.ts,cypress/e2e/auth/**/*.cy.ts,cypress/e2e/home/**/*.cy.ts,cypress/e2e/extrato/**/*.cy.ts,cypress/e2e/pix/pix-cobranca.cy.ts,cypress/e2e/pix/pix-validacoes.cy.ts\"",
    "test:transferencias": "cypress run --spec \"cypress/e2e/pix/pix.cy.ts,cypress/e2e/ted/ted.cy.ts\"",
    "test:extrato": "cypress run --spec \"cypress/e2e/extrato/**/*.cy.ts\"",
    "test:ted": "cypress run --spec \"cypress/e2e/ted/**/*.cy.ts\""
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "typescript": "^5.6.3"
  }
}
